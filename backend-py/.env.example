# Copy to .env and fill in. All values fall back to safe local defaults if unset.

# SQLite by default. Any SQLAlchemy URL works, e.g. postgresql+psycopg://...
TAALMEL_DATABASE_URL=sqlite:///data/taalmel.db

# Required for the ARQ OCR worker. Not needed when OCR_INLINE is on.
TAALMEL_REDIS_URL=redis://localhost:6379

# Where uploaded prescriptions are written.
TAALMEL_UPLOAD_DIR=data/uploads

# Dev/test: run OCR synchronously in-process. Set false in deployment to use ARQ.
TAALMEL_OCR_INLINE=true

# MUST be replaced before any real deployment. Use a random 32+ byte value.
TAALMEL_JWT_SECRET=dev-only-change-me
TAALMEL_JWT_ALGORITHM=HS256
TAALMEL_ACCESS_TOKEN_MINUTES=15
TAALMEL_REFRESH_TOKEN_DAYS=7
TAALMEL_LOGIN_RATE_LIMIT=10/minute
