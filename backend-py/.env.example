# Copy to .env and fill in. All values fall back to safe local defaults if unset.

# SQLite by default. Any SQLAlchemy URL works, e.g. postgresql+psycopg://...
TAALMEL_DATABASE_URL=sqlite:///data/taalmel.db

# Required for the ARQ OCR worker. Not needed when OCR_INLINE is on.
TAALMEL_REDIS_URL=redis://localhost:6379

# Where uploaded prescriptions are written.
TAALMEL_UPLOAD_DIR=data/uploads

# Dev/test: run OCR synchronously in-process. Set false in deployment to use ARQ.
TAALMEL_OCR_INLINE=true
# 'inline' (default) or 'arq'. ocr_inline=false also selects ARQ.
TAALMEL_JOB_QUEUE=inline

# OCR: auto | easyocr | google | gemini | trocr | stub
# auto uses Google Vision, then Gemini, then EasyOCR based on the keys installed.
TAALMEL_OCR_ENGINE=auto
TAALMEL_OCR_LANGUAGES=en
# Handwritten Indian prescriptions: Cloud Vision key (needs billing) or Gemini key
# from Google AI Studio (free tier, no billing account required).
TAALMEL_GOOGLE_VISION_API_KEY=
TAALMEL_GEMINI_API_KEY=
TAALMEL_GEMINI_MODEL=gemini-2.0-flash
# Local alternative (needs the handwriting extra): microsoft/trocr-small-handwritten
TAALMEL_TROCR_MODEL=microsoft/trocr-small-handwritten

# Notification delivery. Rows are always written; configure one channel to send them.
# Webhook works with SMS/push relays; SMTP sends to the user's registered email.
TAALMEL_NOTIFICATION_WEBHOOK_URL=
TAALMEL_NOTIFICATION_WEBHOOK_TOKEN=
TAALMEL_SMTP_HOST=
TAALMEL_SMTP_PORT=587
TAALMEL_SMTP_USERNAME=
TAALMEL_SMTP_PASSWORD=
TAALMEL_SMTP_FROM=
TAALMEL_SMTP_USE_TLS=true

# Pharmacy ordering. Empty uses the local mock provider.
TAALMEL_PHARMACY_API_URL=
TAALMEL_PHARMACY_API_KEY=

# MUST be replaced before any real deployment. Use a random 32+ byte value.
TAALMEL_JWT_SECRET=dev-only-change-me
TAALMEL_JWT_ALGORITHM=HS256
TAALMEL_ACCESS_TOKEN_MINUTES=15
TAALMEL_REFRESH_TOKEN_DAYS=7
TAALMEL_LOGIN_RATE_LIMIT=10/minute
