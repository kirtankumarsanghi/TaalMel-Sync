generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  role         String // 'caregiver' | 'patient'
  name         String
  phone        String?  @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  createdHouseholds        Household[]
  householdMembers         HouseholdMember[]
  caregiverAccesses        CaregiverAccess[]
  refreshTokens            RefreshToken[]
  events                   Event[]
  notifications            Notification[]
  auditRecords             AuditRecord[]
  uploadedPrescriptions    Prescription[]     @relation("PrescriptionUploader")
  verifiedPrescriptions    Prescription[]     @relation("PrescriptionVerifier")
  verifiedPrescriptionItems PrescriptionItem[] @relation("PrescriptionItemVerifier")
  createdEvents            Event[]            @relation("EventCreator")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @map("token_hash")
  userId    String    @map("user_id")
  family    String
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

model Household {
  id        String   @id @default(uuid())
  name      String
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  creator User              @relation(fields: [createdBy], references: [id])
  members HouseholdMember[]

  @@map("households")
}

model HouseholdMember {
  id           String   @id @default(uuid())
  householdId  String   @map("household_id")
  userId       String?  @map("user_id")
  displayName  String   @map("display_name")
  relationship String?
  role         String   @default("member") // 'owner' | 'caregiver' | 'member'
  isPatient    Boolean  @default(true) @map("is_patient")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  household       Household         @relation(fields: [householdId], references: [id])
  user            User?             @relation(fields: [userId], references: [id])
  medications     Medication[]
  accesses        CaregiverAccess[]
  doctorQuestions DoctorQuestion[]
  symptomChecks   SymptomCheck[]
  patient         Patient?
  prescriptions   Prescription[]
  events          Event[]

  @@map("household_members")
}

model Patient {
  id                String   @id @default(uuid())
  householdMemberId String   @unique @map("household_member_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  householdMember HouseholdMember @relation(fields: [householdMemberId], references: [id])

  @@map("patients")
}

model CaregiverAccess {
  id                String   @id @default(uuid())
  caregiverUserId   String   @map("caregiver_user_id")
  householdMemberId String   @map("household_member_id")
  grantedAt         DateTime @default(now()) @map("granted_at")
  consentRecorded   Boolean  @default(false) @map("consent_recorded")
  updatedAt         DateTime @updatedAt @map("updated_at")

  caregiver       User            @relation(fields: [caregiverUserId], references: [id])
  householdMember HouseholdMember @relation(fields: [householdMemberId], references: [id])
  consent         Consent?

  @@unique([caregiverUserId, householdMemberId])
  @@map("caregiver_access")
}

model Consent {
  id                String    @id @default(uuid())
  caregiverAccessId String    @unique @map("caregiver_access_id")
  consentType       String    @default("data_access") @map("consent_type") // 'data_access' | 'medication_management' | 'full_care'
  consentMethod     String    @default("in_app") @map("consent_method") // 'in_app' | 'verbal' | 'written'
  recordedAt        DateTime  @default(now()) @map("recorded_at")
  revokedAt         DateTime? @map("revoked_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  caregiverAccess CaregiverAccess @relation(fields: [caregiverAccessId], references: [id])

  @@map("consents")
}

model MedicationCanonical {
  id               String   @id @default(uuid())
  genericName      String   @map("generic_name")
  brandNames       String   @default("[]") @map("brand_names")
  strength         String?
  strengthUnit     String?  @map("strength_unit")
  dosageForm       String?  @map("dosage_form")
  activeIngredient String?  @map("active_ingredient")
  category         String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  medications Medication[]

  @@unique([genericName, strength, dosageForm])
  @@map("medication_canonicals")
}

model Medication {
  id                String   @id @default(uuid())
  householdMemberId String   @map("household_member_id")
  nameRaw           String   @map("name_raw")
  nameGeneric       String?  @map("name_generic")
  nameBrand         String?  @map("name_brand")
  doseRaw           String?  @map("dose_raw")
  strength          String?
  strengthRaw       String?  @map("strength_raw")
  dosageForm        String?  @map("dosage_form")
  dosageFormRaw     String?  @map("dosage_form_raw")
  frequencyRaw      String?  @map("frequency_raw")
  frequency         String?
  durationRaw       String?  @map("duration_raw")
  duration          String?
  instructionsRaw   String?  @map("instructions_raw")
  instructions      String?
  identityConfirmed Boolean  @default(false) @map("identity_confirmed")

  normalizationStatus     String  @default("PENDING") @map("normalization_status")
  normalizationMethod     String? @map("normalization_method")
  normalizationConfidence Float?  @map("normalization_confidence")

  canonicalId        String?  @map("canonical_id")
  prescriptionItemId String?  @map("prescription_item_id")

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  householdMember HouseholdMember      @relation(fields: [householdMemberId], references: [id])
  canonical       MedicationCanonical? @relation(fields: [canonicalId], references: [id])
  events          Event[]
  cases           Case[]
  doctorQuestions DoctorQuestion[]
  evidence        Evidence[]
  conflicts       Conflict[]

  @@index([householdMemberId])
  @@index([canonicalId])
  @@index([normalizationStatus])
  @@map("medications")
}

model NormalizationLog {
  id             String   @id @default(uuid())
  medicationId   String   @map("medication_id")
  inputRaw       String   @map("input_raw")
  outputGeneric  String?  @map("output_generic")
  outputStrength String?  @map("output_strength")
  outputForm     String?  @map("output_form")
  method         String
  confidence     Float
  status         String
  reviewNote     String?  @map("review_note")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([medicationId])
  @@map("normalization_logs")
}

model Prescription {
  id                String    @id @default(uuid())
  householdMemberId String    @map("household_member_id")
  prescribedBy      String?   @map("prescribed_by")
  fileStorageKey    String    @map("file_storage_key")
  originalFilename  String    @map("original_filename")
  mimeType          String    @map("mime_type")
  fileSizeBytes     Int       @map("file_size_bytes")
  fileHash          String    @map("file_hash")
  ocrStatus         String    @default("PENDING") @map("ocr_status") // PENDING | PROCESSING | COMPLETED | FAILED | NEEDS_REVIEW
  ocrRawText        String?   @map("ocr_raw_text")
  ocrCompletedAt    DateTime? @map("ocr_completed_at")
  ocrError          String?   @map("ocr_error")
  uploadedByUserId  String    @map("uploaded_by_user_id")
  verified          Boolean   @default(false)
  verifiedAt        DateTime? @map("verified_at")
  verifiedByUserId  String?   @map("verified_by_user_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  householdMember HouseholdMember    @relation(fields: [householdMemberId], references: [id])
  uploadedByUser  User               @relation("PrescriptionUploader", fields: [uploadedByUserId], references: [id])
  verifiedByUser  User?              @relation("PrescriptionVerifier", fields: [verifiedByUserId], references: [id])
  items           PrescriptionItem[]

  @@unique([householdMemberId, fileHash])
  @@index([householdMemberId])
  @@index([ocrStatus])
  @@map("prescriptions")
}

model PrescriptionItem {
  id               String    @id @default(uuid())
  prescriptionId   String    @map("prescription_id")
  medicationName   String    @map("medication_name")
  dosage           String?
  frequency        String?
  instructions     String?
  confidence       Float     @default(0)
  ocrRawValue      String?   @map("ocr_raw_value")
  verified         Boolean   @default(false)
  verifiedAt       DateTime? @map("verified_at")
  verifiedByUserId String?   @map("verified_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  prescription Prescription @relation(fields: [prescriptionId], references: [id])
  verifiedByUser User?      @relation("PrescriptionItemVerifier", fields: [verifiedByUserId], references: [id])

  @@map("prescription_items")
}

model Event {
  id                String   @id @default(uuid())
  householdMemberId String   @map("household_member_id")
  medicationId      String?  @map("medication_id")
  eventType         String   @map("event_type")
  payload           String
  source            String
  sourceUserId      String?  @map("source_user_id")
  idempotencyKey    String?  @unique @map("idempotency_key")
  occurredAt        DateTime @default(now()) @map("occurred_at")
  createdAt         DateTime @default(now()) @map("created_at")
  createdBy         String?  @map("created_by")

  householdMember HouseholdMember @relation(fields: [householdMemberId], references: [id])
  medication      Medication?     @relation(fields: [medicationId], references: [id])
  sourceUser      User?           @relation(fields: [sourceUserId], references: [id])
  createdByUser   User?           @relation("EventCreator", fields: [createdBy], references: [id])
  cases           Case[]          @relation("CaseTriggerEvent")

  @@index([householdMemberId])
  @@index([medicationId])
  @@index([eventType])
  @@map("events")
}

model Case {
  id             String    @id @default(uuid())
  medicationId   String    @map("medication_id")
  triggerEventId String?   @map("trigger_event_id")
  reasonCode     String?   @map("reason_code")
  status         String    @default("OPEN") // 'OPEN' | 'AWAITING_INFO' | 'RESOLVED' | 'STILL_UNCERTAIN'
  actionTaken    String?   @map("action_taken")
  openedAt       DateTime  @default(now()) @map("opened_at")
  resolvedAt     DateTime? @map("resolved_at")
  resolutionNote String?   @map("resolution_note")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  medication   Medication @relation(fields: [medicationId], references: [id])
  triggerEvent Event?     @relation("CaseTriggerEvent", fields: [triggerEventId], references: [id])

  @@index([medicationId])
  @@index([status])
  @@map("cases")
}

model DoctorQuestion {
  id                String    @id @default(uuid())
  medicationId      String?   @map("medication_id")
  householdMemberId String    @map("household_member_id")
  questionText      String    @map("question_text")
  raisedBy          String    @map("raised_by")
  status            String    @default("PENDING") // 'PENDING' | 'DISCUSSED'
  createdAt         DateTime  @default(now()) @map("created_at")
  discussedAt       DateTime? @map("discussed_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  medication      Medication?     @relation(fields: [medicationId], references: [id])
  householdMember HouseholdMember @relation(fields: [householdMemberId], references: [id])

  @@map("doctor_questions")
}

model SymptomCheck {
  id                String   @id @default(uuid())
  householdMemberId String   @map("household_member_id")
  symptomText       String   @map("symptom_text")
  redFlagMatched    Boolean? @map("red_flag_matched")
  outcome           String? // 'ESCALATE' | 'SELF_CARE_INFO' | 'NOT_EVALUATED'
  sourceReference   String?  @map("source_reference")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  householdMember HouseholdMember @relation(fields: [householdMemberId], references: [id])

  @@map("symptom_checks")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  body      String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model AuditRecord {
  id        String   @id @default(uuid())
  action    String
  userId    String?  @map("user_id")
  details   String
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_records")
}

model Evidence {
  id           String   @id @default(uuid())
  medicationId String   @map("medication_id")
  type         String
  url          String?
  payload      String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  medication Medication @relation(fields: [medicationId], references: [id])

  @@map("evidence")
}

model Conflict {
  id                 String   @id @default(uuid())
  medicationId       String   @map("medication_id")
  type               String
  description        String
  dimensionsInvolved String   @map("dimensions_involved")
  suggestedQuestion  String?  @map("suggested_question")
  status             String   @default("OPEN")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  medication Medication @relation(fields: [medicationId], references: [id])

  @@map("conflicts")
}
